QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# 角色级多模型路由（可选）。不填则所有 LLM 角色共用上面的默认模型。
# 未覆盖的字段自动回落到 QWEN_* 默认值。
# 例：生产者用 DeepSeek，审核助手用阿里云通义千问
EXTRACTOR_MODEL=
EXTRACTOR_API_KEY=
EXTRACTOR_BASE_URL=

REVIEW_ASSISTANT_MODEL=
REVIEW_ASSISTANT_API_KEY=
REVIEW_ASSISTANT_BASE_URL=

FLASK_DEBUG=false
FLASK_PORT=5001

POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://orders:change_me@postgres:5432/orders

RISK_CONFIDENCE_THRESHOLD=0.8
RISK_MATCH_THRESHOLD=0.8

DATA_DIR=data
FAISS_INDEX_PATH=data/faiss_index
STANDARD_MATERIALS_PATH=data/standard_materials.csv
ORDER_AUTO_ARCHIVE_DAYS=30
