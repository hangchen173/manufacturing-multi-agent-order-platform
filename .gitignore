# Frozen regression fixtures must travel with their content hashes. Ignore the
# contents of self_built and whitelist the fixture directories; ignoring the
# directory itself would make every negation below ineffective.
datasets/self_built/*
!datasets/self_built/interview_v1/
!datasets/self_built/pdf_regression_v1/
!datasets/self_built/excel_regression_v1/
!datasets/self_built/interview_v1/**/orders/*.pdf
!datasets/self_built/interview_v1/**/orders/*.xlsx
!datasets/self_built/interview_v1/**/orders/*.png
!datasets/self_built/pdf_regression_v1/orders/*.pdf
!datasets/self_built/excel_regression_v1/orders/*.xlsx

evaluation/results/*
!evaluation/results/excel_column_fix_20260912/
